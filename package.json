{
  "name": "winiger-freres-site",
  "private": true,
  "description": "Site Winiger Frères : pages statiques (tools/build.py) et expérience 3D (src/3d, Three.js)",
  "scripts": {
    "build:3d": "esbuild src/3d/main.js --bundle --format=esm --minify --target=es2020 --outfile=assets/js/experience.js --legal-comments=none",
    "watch:3d": "esbuild src/3d/main.js --bundle --format=esm --sourcemap --target=es2020 --outfile=assets/js/experience.js --watch",
    "build": "python3 tools/build.py && npm run build:3d"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "three": "0.180.0"
  }
}
