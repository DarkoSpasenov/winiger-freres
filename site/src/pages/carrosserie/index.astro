---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pic from '../../components/Pic.astro';
import Btn from '../../components/Btn.astro';
import Sector from '../../components/Sector.astro';
import Placeholder from '../../components/Placeholder.astro';
import { services, insurers } from '../../data/site';
const steps = [
  { t: 'Contact & devis', d: 'Un appel, un e-mail ou une visite. Le devis est gratuit.' },
  { t: 'Prise en charge', d: 'Votre véhicule est pris en charge sur le lieu de votre choix ; accompagnement à domicile ou au travail.' },
  { t: 'Sinistre', d: "Nous vous soutenons dans l'annonce et la gestion du sinistre avec votre assurance." },
  { t: 'Mobilité', d: 'Une voiture de remplacement récente pendant les travaux.' },
  { t: 'Réparation', d: 'Carrosserie, peinture, vitrage : le travail est réalisé à l’atelier de Grolley.' },
];
---
<Base title="Carrosserie & services — réparation toutes marques à Grolley" description="Réparation toutes marques, travaux de carrosserie, débosselage, peinture au four et peinture mate, pare-brise et vitrages, teintage, climatisation et voitures de remplacement à Grolley (FR).">
  <PageHero img="atelier-fb2" id="grille" labelledby="c-title" position="50% 55%">
    <Fragment slot="marks">
      <span class="wp" data-wp="l" style="top:calc(var(--header) + 20px)"></span>
      <Sector n="1" name="Prestations" id="grille" />
    </Fragment>
    <p class="eyebrow">Carrosserie & services <b>·</b> 07 prestations</p>
    <h1 id="c-title" class="display">Carrosserie<br />toutes marques<span class="red">.</span></h1>
  </PageHero>
  <div class="wrap c-tocwrap">
    <nav class="c-toc" aria-label="Prestations">
      <ol>
        {services.map((s) => <li><a href={`#${s.id}`}><span class="mono">{s.code}</span>{s.title}</a></li>)}
      </ol>
    </nav>
  </div>

  <div class="c-chapters">
    {services.map((s, i) => (
      <section class:list={['section', 'c-ch', i % 2 ? 'c-ch--r' : 'c-ch--l', i % 3 === 1 && 'bg-paper']} id={s.id} aria-labelledby={`t-${s.id}`}>
        <span class="wp" data-wp={i % 2 ? 'r' : 'l'} style="top:40px"></span>
        <Sector n={String(i + 2)} name={s.title} id={s.id} side={i % 2 ? 'r' : 'l'} />
        <div class="wrap grid">
          <div class="c-ch__media">
            {s.img ? <Pic name={s.img as any} ratio={i % 2 ? '4/5' : '3/2'} sizes="(min-width: 901px) 50vw, 100vw" /> : <Placeholder text={s.ph!} ratio={i % 2 ? '4/5' : '3/2'} />}
          </div>
          <div class="c-ch__text">
            <p class="c-ch__code" aria-hidden="true">{s.code}</p>
            <h2 id={`t-${s.id}`} class="display h2 c-ch__title">{s.title}</h2>
            <p class="lead">{s.text}</p>
            {s.id === 'peinture' && (
              <dl class="spec" style="margin-top:28px">
                <div><dt>Four</dt><dd>Peinture au four</dd></div>
                <div><dt>Mat</dt><dd>Une finition qui demande une attention particulière pour rester durable</dd></div>
                <div><dt>Ancienne</dt><dd>Restauration de la peinture des véhicules de collection</dd></div>
                <div><dt>Produits</dt><dd>Produits écologiques</dd></div>
              </dl>
            )}
            {s.id === 'reparation' && <p class="mono muted" style="margin-top:20px"><a href="#assurances">Assurances partenaires : {insurers.join(' · ')}</a></p>}
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="section bg-paper c-ins" id="assurances" aria-labelledby="c-ins">
    <div class="wrap">
      <div class="c-ins__head">
        <p class="eyebrow">Sinistres <b>/</b> Assurances partenaires</p>
        <h2 id="c-ins" class="display h2">Vos assureurs<br />nous connaissent<span class="red">.</span></h2>
        <p class="lead">Nous gérons le sinistre directement avec votre assurance.</p>
      </div>
      <ul class="c-ins__grid" aria-label="Assurances partenaires">
        {insurers.map((n, i) => {
          const [name, note] = n.replace(')', '').split(' (');
          return <li><span class="mono">{String(i + 1).padStart(2, '0')}</span><strong>{name}</strong>{note && <em class="mono">{note}</em>}</li>;
        })}
      </ul>
    </div>
  </section>

  <section class="section bg-ink on-dark" id="deroulement" aria-labelledby="c-steps">
    <span class="wp" data-wp="l" style="top:40px"></span>
    <Sector n="9" name="Déroulement" id="deroulement" />
    <div class="wrap">
      <p class="eyebrow">Déroulement</p>
      <h2 id="c-steps" class="display h2" style="margin-bottom:clamp(40px,5vw,72px)">Du sinistre<br />à la resti&shy;tution.</h2>
      <ol class="c-steps">
        {steps.map((s, i) => <li><span class="mono">T{String(i + 1).padStart(2, '0')}</span><h3 class="h3">{s.t}</h3><p>{s.d}</p></li>)}
      </ol>
      <div class="btns" style="margin-top:clamp(40px,5vw,72px)"><Btn href="/contact/" variant="solid">Demander un devis</Btn><Btn href="tel:+41264760606">026 476 06 06</Btn></div>
    </div>
  </section>
</Base>
<style is:global>
  .c-ins__head .lead { margin-top: 20px; }
  .c-ins__head { max-width: 760px; margin-bottom: clamp(32px, 4vw, 56px); }
  .c-ins__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--g); }
  .c-ins__grid li { position: relative; display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; min-height: 140px; padding: 18px 22px 20px 34px; background: var(--white);
    clip-path: polygon(16px 0, 100% 0, calc(100% - 16px) 100%, 0 100%); border-bottom: 6px solid transparent; border-image: var(--kerb) 6; transition: background .3s, color .3s; }
  .c-ins__grid li > span.mono { position: absolute; top: 16px; left: 34px; color: var(--red); }
  .c-ins__grid strong { font-weight: 900; font-stretch: 125%; font-style: italic; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1; font-size: clamp(1.3rem, 2.2vw, 2rem); }
  .c-ins__grid em { font-style: normal; color: var(--steel); font-size: .75rem; }
  .c-ins__grid li:hover { background: var(--ink); color: var(--white); }
  @media (max-width: 900px) { .c-ins__grid { grid-template-columns: 1fr 1fr; } .c-ins__grid li { min-height: 110px; padding: 14px 16px 16px 26px; } .c-ins__grid li > span.mono { left: 26px; } }
  .wp { position: absolute; left: 0; width: 1px; height: 1px; pointer-events: none; }
  .c-hero__grid { align-items: end; row-gap: 40px; margin-bottom: clamp(40px, 5vw, 72px); }
  .c-hero__t { grid-column: 1 / span 7; }
  .c-tocwrap { padding-top: clamp(40px, 5vw, 72px); }
  .c-toc ol { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); column-gap: var(--g); }
  .c-toc ol { list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); }
  .c-toc a { display: flex; gap: 16px; align-items: baseline; padding: 10px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-weight: 600; font-stretch: 110%; transition: padding .3s var(--ease), color .3s; }
  .c-toc a .mono { color: var(--steel); }
  .c-toc a:hover { padding-left: 8px; color: var(--red); }
  .c-ch .grid { align-items: center; row-gap: 32px; }
  .c-ch--l .c-ch__media { grid-column: 1 / span 6; }
  .c-ch--l .c-ch__text { grid-column: 8 / span 5; }
  .c-ch--r .c-ch__media { grid-column: 8 / span 4; grid-row: 1; }
  .c-ch--r .c-ch__text { grid-column: 1 / span 6; grid-row: 1; }
  .c-ch__code { font-family: var(--f-mono); font-size: clamp(3.5rem, 7vw, 7rem); line-height: 1; color: transparent; -webkit-text-stroke: 1px var(--red); margin: 0 0 18px; letter-spacing: -0.04em; }
  .c-ch__title { font-size: min(clamp(1.8rem, 4vw, 4rem), 7.6cqi); margin-bottom: 24px; }
  .c-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--g); counter-reset: st; }
  .c-steps li { border-top: 1.5px solid var(--white); padding-top: 18px; position: relative; }
  .c-steps li::before { content: ''; position: absolute; top: -6px; left: 0; width: 11px; height: 11px; border-radius: 50%; background: var(--red); }
  .c-steps .mono { color: var(--red); }
  .c-steps h3 { margin: 10px 0 10px; }
  .c-steps p { color: rgba(255,255,255,.72); font-size: .95rem; }
  @media (max-width: 1000px) { .c-steps { grid-template-columns: 1fr 1fr; row-gap: 40px; } }
  @media (max-width: 900px) { .c-ch--r .c-ch__media, .c-ch--r .c-ch__text { grid-row: auto; } }
  @media (max-width: 560px) { .c-steps { grid-template-columns: 1fr; } }
</style>
