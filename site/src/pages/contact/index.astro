---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Btn from '../../components/Btn.astro';
import Sector from '../../components/Sector.astro';
import Hours from '../../components/Hours.astro';
import Pic from '../../components/Pic.astro';
import ContactForm from '../../components/ContactForm.astro';
import { company, mapsLink, appleMapsLink, wash, urgent } from '../../data/site';
---
<Base title="Contact — Carrosserie de Grolley, 026 476 06 06" description="Contactez Winiger Frères Sàrl, Carrosserie de Grolley : Route de l'Industrie-Ouest 11, 1772 Grolley. Tél. 026 476 06 06, carrosserie@winiger-artcar.ch. Horaires, itinéraire et formulaire." schema>
  <PageHero img="reception-2023" id="coordonnees" labelledby="k-title" position="55% 55%">
    <Fragment slot="marks">
      <span class="wp" data-wp="l" style="top:calc(var(--header) + 20px)"></span>
      <Sector n="1" name="Coordonnées" id="coordonnees" />
    </Fragment>
    <p class="eyebrow">Contact <b>·</b> Ligne d'arrivée</p>
    <h1 id="k-title" class="display"><a href={`tel:${company.phoneHref}`} class="k-tel">026 476 06 06</a><span class="red">.</span></h1>
    <div class="btns">
      <Btn href={`tel:${company.phoneHref}`} variant="red">Appeler l'atelier</Btn>
      <Btn href={`mailto:${company.email}`}>Écrire un e-mail</Btn>
    </div>
  </PageHero>
  <section class="section section--tight k-info" aria-label="Coordonnées détaillées">
    <div class="wrap">
      <div class="grid k-grid">
        <div class="k-col">
          <p class="mono muted">Atelier</p>
          <address>
            <strong>{company.name}</strong><br />{company.tagline}<br />{company.street}<br />{company.zip} {company.city}
          </address>
          <div class="btns" style="margin-top:24px">
            <Btn href={`tel:${company.phoneHref}`} variant="red">Appeler l'atelier</Btn>
            <Btn href={`mailto:${company.email}`}>Écrire un e-mail</Btn>
          </div>
        </div>
        <div class="k-col">
          <p class="mono muted">Lignes directes</p>
          <dl class="spec">
            <div><dt>Secrétariat</dt><dd><a href={`tel:${company.phoneHref}`}>{company.phone}</a></dd></div>
            <div><dt>Fax</dt><dd>{company.fax}</dd></div>
            {company.founders.map((f) => <div><dt>{f.first}</dt><dd><a href={`tel:${f.mobileHref}`}>{f.mobile}</a></dd></div>)}
            <div><dt>E-mail</dt><dd><a href={`mailto:${company.email}`}>{company.email}</a></dd></div>
          </dl>
          <p class="muted" style="margin-top:14px;font-size:.9rem">{urgent}</p>
        </div>
        <div class="k-col">
          <p class="mono muted">Horaires de l'atelier</p>
          <Hours />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-paper" id="message" aria-labelledby="k-form">
    <span class="wp" data-wp="r" style="top:40px"></span>
    <Sector n="2" name="Message" id="message" />
    <div class="wrap grid" style="row-gap:40px">
      <div style="grid-column: 1 / span 4">
        <p class="eyebrow">S2 <b>/</b> Formulaire</p>
        <h2 id="k-form" class="display h2">Votre<br />demande.</h2>
        <p style="margin-top:24px;color:var(--ink-2);max-width:34ch">Devis, sinistre, gardiennage ou station de lavage : décrivez votre demande, l'atelier vous répond.</p>
      </div>
      <div style="grid-column: 6 / span 7; background:var(--white); padding:clamp(22px,3vw,44px)"><ContactForm idPrefix="contact" /></div>
    </div>
  </section>

  <section class="section" id="acces" aria-labelledby="k-map">
    <span class="wp" data-wp="l" style="top:40px"></span>
    <Sector n="3" name="Accès" id="acces" />
    <div class="wrap grid" style="row-gap:40px;align-items:center">
      <div style="grid-column: 1 / span 6"><Pic name="facade-enseigne" ratio="16/10" sizes="(min-width: 901px) 50vw, 100vw" class="corner-tl" /></div>
      <div style="grid-column: 8 / span 5">
        <p class="eyebrow">S3 <b>/</b> Accès</p>
        <h2 id="k-map" class="display h2">Grolley,<br />zone<br />indus&shy;trielle.</h2>
        <dl class="spec" style="margin-top:28px">
          <div><dt>Carrosserie</dt><dd>{company.street}, {company.zip} {company.city}</dd></div>
          <div><dt>Lavage</dt><dd>{wash.street}, 1772 Grolley</dd></div>
          <div><dt>Parking</dt><dd>Places de stationnement sur place</dd></div>
        </dl>
        <div class="btns" style="margin-top:28px">
          <Btn href={mapsLink(company.mapsQuery)} variant="solid" external>Google Maps</Btn>
          <Btn href={appleMapsLink(company.mapsQuery)} external>Plans (Apple)</Btn>
        </div>
      </div>
    </div>
  </section>

  <div class="k-finish" id="arrivee" aria-hidden="true">
    <span class="wp" data-wp="50%" style="top:0"></span>
    <div class="checker" style="height:56px"></div>
  </div>
</Base>
<style is:global>
  .wp { position: absolute; left: 0; width: 1px; height: 1px; pointer-events: none; }
  .k-hero { padding-bottom: clamp(72px, 9vw, 140px); }
  .k-hero .giant { margin-bottom: clamp(40px, 6vw, 88px); }
  .k-grid { row-gap: 48px; border-top: 1.5px solid var(--ink); padding-top: 32px; }
  .k-col { grid-column: span 4; }
  .k-col > .mono { margin-bottom: 14px; }
  .k-col address { font-style: normal; font-size: 1.2rem; line-height: 1.55; }
  .k-col .spec a { text-decoration: none; }
  .k-col .spec a:hover { color: var(--red); }
  @media (max-width: 1100px) { .k-col { grid-column: span 6; } .k-col:last-child { grid-column: span 12; } }
  .k-finish { position: relative; }
</style>
