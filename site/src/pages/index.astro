---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Btn from '../components/Btn.astro';
import Sector from '../components/Sector.astro';
import Todo from '../components/Todo.astro';
import Hours from '../components/Hours.astro';
import { company, services, storage, wash, prestigeBrands, mapsLink, certifications } from '../data/site';

// Accueil : une photo réelle de l'atelier pour chaque prestation (le texte détaillé est sur /carrosserie/)
const tileImg: Record<string, string> = {
  reparation: 'atelier-6194',
  carrosserie: 'atelier-9880',
  debosselage: 'atelier-fb4',
  peinture: 'atelier-6314',
  vitrages: 'atelier-4916',
  remplacement: 'ext-6177',
  complementaires: 'atelier-9877',
};
const ticker = ['Carrosserie toutes marques', 'Prestige & collection', 'TESLA Approved Body Shop', 'Compétition', 'Gardiennage chauffé', 'Tunnel de lavage', 'Grolley · Fribourg'];
---
<Base
  title="Winiger Frères · Carrosserie de Grolley (Fribourg) — depuis 2004"
  description="Carrosserie toutes marques à Grolley (FR) depuis 2004 : réparation, peinture, vitrages, véhicules de prestige et de collection, TESLA Approved Body Shop, gardiennage chauffé et tunnel de lavage."
  schema
>
  <!-- ========== S1 · DÉPART ========== -->
  <section class="h-hero" id="depart" aria-labelledby="h-hero-title">
    <Sector n="1" name="Départ" id="ligne-depart" href="#depart" ghost />
    <Pic name="ext-008" class="h-hero__bg" sizes="100vw" priority mask={false} position="50% 62%" />
    <div class="h-hero__shade" aria-hidden="true"></div>
    <div class="wrap h-hero__inner">
      <div class="h-start" id="ligne-depart" aria-hidden="true">
        <span class="wp" data-wp="l"></span>
        <div class="h-start__grid checker"></div>
        <div class="lights"><i></i><i></i><i></i><i></i><i></i></div>
      </div>
      <p class="h-hero__kicker mono">Carrosserie de Grolley <b>·</b> depuis {company.founded}</p>
      <h1 id="h-hero-title" class="display giant h-hero__title">
        <span class="line">La précision</span>
        <span class="line">pour passion<span class="red">.</span></span>
      </h1>
      <div class="btns h-hero__btns">
        <Btn href="/carrosserie/" variant="red">Nos prestations</Btn>
        <Btn href={`tel:${company.phoneHref}`}>{company.phone}</Btn>
      </div>
    </div>
    <div class="h-hero__grid checker" aria-hidden="true"></div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {[0, 1].map(() => <span>{ticker.map((t) => <span>{t}<i></i></span>)}</span>)}
    </div>
  </div>

  <!-- ========== S2 · L'ENTREPRISE ========== -->
  <section class="section h-story" id="entreprise" aria-labelledby="h-story-title">
    <span class="wp" data-wp="l" style="top:40px"></span>
    <Sector n="2" name="L'entreprise" id="entreprise" />
    <div class="wrap grid h-story__grid">
      <div class="h-story__media">
        <Pic name="atelier-fb1" ratio="16/10" sizes="(min-width: 901px) 58vw, 100vw" class="corner-tl" />
      </div>
      <div class="h-story__text">
        <p class="h-year display" aria-hidden="true">2004</p>
        <h2 id="h-story-title" class="display h2">Deux frères,<br />une passion.</h2>
        <ul class="h-drivers" aria-label="Les fondateurs">
          {company.founders.map((f, i) => (
            <li><span class="plate">{i + 1}</span><strong>{f.first} <span>{f.last}</span></strong></li>
          ))}
        </ul>
        <Btn href="/entreprise/">Notre histoire</Btn>
      </div>
    </div>
    <div class="wrap h-strip3">
      <Pic name="enseigne-6221" ratio="4/3" sizes="(min-width: 901px) 32vw, 100vw" />
      <Pic name="atelier-2441" ratio="4/3" sizes="(min-width: 901px) 32vw, 100vw" />
      <Pic name="atelier-6191" ratio="4/3" sizes="(min-width: 901px) 32vw, 100vw" />
    </div>
  </section>

  <!-- ========== S3 · CARROSSERIE ========== -->
  <section class="section bg-paper h-services" id="carrosserie" aria-labelledby="h-serv-title">
    <span class="wp" data-wp="r" style="top:40px"></span>
    <Sector n="3" name="Carrosserie" id="carrosserie" />
    <div class="wrap">
      <div class="h-head">
        <h2 id="h-serv-title" class="display h2">Toutes marques<span class="red">.</span><br />Tous travaux<span class="red">.</span></h2>
        <Btn href="/carrosserie/" variant="solid">Toutes les prestations</Btn>
      </div>
      <ol class="tiles">
        {services.map((s, i) => (
          <li class={`tile tile--${i + 1}`}>
            <a href={`/carrosserie/#${s.id}`}>
              <Pic name={tileImg[s.id] as any} sizes="(min-width: 901px) 50vw, 100vw" alt="" />
              <span class="tile__no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="tile__title">{s.title}</span>
            </a>
          </li>
        ))}
        <li class="tile tile--cta">
          <div>
            <p class="mono">Inclus</p>
            <ul>
              <li>Devis gratuits</li>
              <li>Voitures de remplacement</li>
              <li>Gestion des sinistres</li>
              <li>Qualité FCR</li>
            </ul>
            <Btn href="/contact/" variant="solid">Demander un devis</Btn>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- ========== S4 · PRESTIGE ========== -->
  <section class="bg-ink h-prestige on-dark" id="prestige" aria-labelledby="h-pres-title">
    <span class="wp" data-wp="r" style="top:40px"></span>
    <Sector n="4" name="Prestige" id="prestige" side="r" />
    <div class="h-full">
      <Pic name="ferrari-6215" sizes="100vw" mask={false} position="50% 55%" />
      <div class="h-full__shade" aria-hidden="true"></div>
      <div class="wrap h-full__text">
        <h2 id="h-pres-title" class="display h1">Sport,<br />prestige<br /><span class="red">& collection</span></h2>
      </div>
    </div>
    <div class="ticker ticker--brands" aria-hidden="true">
      <div class="ticker__track">
        {[0, 1].map(() => <span>{prestigeBrands.map((b) => <span>{b}<i></i></span>)}</span>)}
      </div>
    </div>
    <p class="sr-only">Marques réparées régulièrement à l'atelier : {prestigeBrands.join(', ')}.</p>
    <div class="wrap h-trio">
      <a href="/prestige-collection/#restauration" class="h-trio__a">
        <Pic name="resto-3463" ratio="4/5" sizes="(min-width: 901px) 32vw, 100vw" alt="" />
        <span class="tile__title">Restauration</span>
      </a>
      <a href="/prestige-collection/#competition" class="h-trio__a h-trio__a--low">
        <Pic name="course-fb3" ratio="4/5" sizes="(min-width: 901px) 32vw, 100vw" alt="" position="40% 50%" />
        <span class="tile__title">Compétition</span>
      </a>
      <a href="/prestige-collection/#tesla" class="h-trio__a h-tesla">
        <span class="mono">Agrément constructeur</span>
        <strong>TESLA<br />Approved<br />Body Shop</strong>
        <span class="mono red">Depuis mai 2021</span>
        <span class="link">La compétence Tesla <span class="arr" aria-hidden="true"></span></span>
      </a>
    </div>
  </section>

  <!-- ========== S5 · GARDIENNAGE ========== -->
  <section class="section h-storage" id="gardiennage" aria-labelledby="h-stor-title">
    <span class="wp" data-wp="l" style="top:40px"></span>
    <Sector n="5" name="Gardiennage" id="gardiennage" />
    <div class="wrap">
      <div class="h-head">
        <h2 id="h-stor-title" class="display h2">Au chaud<span class="red">.</span><br />À l'abri<span class="red">.</span></h2>
        <Btn href="/gardiennage/" variant="solid">Gardiennage</Btn>
      </div>
      <div class="h-bays">
        <Pic name="gard-2" class="b1" sizes="(min-width: 901px) 58vw, 100vw" />
        <Pic name="gard-1" class="b2" sizes="(min-width: 901px) 40vw, 100vw" mask="corner" />
        <Pic name="gard-3" class="b3" sizes="(min-width: 901px) 40vw, 100vw" mask="corner" />
      </div>
      <dl class="h-figs">
        <div><dt>Sous-sol chauffé</dt><dd>−1</dd><span>avec ascenseur</span></div>
        <div><dt>Durée</dt><dd>1–12</dd><span>mois</span></div>
        <div><dt>Dès</dt><dd>200.–</dd><span>CHF / mois</span></div>
      </dl>
    </div>
  </section>

  <!-- ========== S6 · STATION DE LAVAGE ========== -->
  <section class="section bg-ink h-wash on-dark" id="lavage" aria-labelledby="h-wash-title">
    <span class="wp" data-wp="r" style="top:40px"></span>
    <Sector n="6" name="Lavage" id="lavage" side="r" />
    <div class="wrap grid h-wash__grid">
      <div class="h-wash__media">
        <Pic name="flyer-tunnel-lavage" ratio="2/3" sizes="(min-width: 901px) 30vw, 80vw" position="50% 30%" />
      </div>
      <div class="h-wash__text">
        <h2 id="h-wash-title" class="display h2">Tunnel<br />de lavage<span class="red">.</span></h2>
        <p class="h-wash__price"><span>{wash.priceFrom}</span> <Todo text="tarif à confirmer" /></p>
        <dl class="spec">
          <div><dt>Adresse</dt><dd>{wash.street}</dd></div>
          <div><dt>Horaires</dt><dd><Todo /></dd></div>
          <div><dt>Paiement</dt><dd><Todo /></dd></div>
        </dl>
        <div class="btns" style="margin-top:32px">
          <Btn href="/station-de-lavage/" variant="solid">La station</Btn>
          <Btn href={mapsLink(wash.mapsQuery)} external>Itinéraire</Btn>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== LOCAUX ========== -->
  <section class="section h-place" id="locaux" aria-labelledby="h-place-title">
    <span class="wp" data-wp="l" style="top:40px"></span>
    <div class="wrap">
      <div class="h-head">
        <h2 id="h-place-title" class="display h2">Industrie-Ouest 11<span class="red">.</span></h2>
        <Btn href="/locaux/" variant="solid">Toutes les photos</Btn>
      </div>
      <div class="h-mosaic">
        <Pic name="facade-nuit-a" class="m1" sizes="(min-width: 901px) 66vw, 85vw" />
        <Pic name="ext-009" class="m2" sizes="(min-width: 901px) 30vw, 85vw" position="50% 60%" />
        <Pic name="atelier-fb2" class="m3" sizes="(min-width: 901px) 40vw, 85vw" />
        <Pic name="ext-016" class="m4" sizes="(min-width: 901px) 26vw, 85vw" />
        <Pic name="ext-5161" class="m5" sizes="(min-width: 901px) 34vw, 85vw" />
      </div>
    </div>
  </section>

  <!-- ========== S7 · CONTACT / S8 · ARRIVÉE ========== -->
  <section class="section bg-ink h-contact on-dark" id="contact" aria-labelledby="h-contact-title">
    <span class="wp" data-wp="r" style="top:40px"></span>
    <Sector n="7" name="Contact" id="contact" side="r" />
    <div class="wrap">
      <h2 id="h-contact-title" class="display giant">Ligne<br />d'arrivée<span class="red">.</span></h2>
      <div class="grid h-contact__grid">
        <div class="h-contact__info">
          <p class="h-contact__phone"><a href={`tel:${company.phoneHref}`}>{company.phone}</a></p>
          <address>
            {company.street}, {company.zip} {company.city}<br />
            <a href={`mailto:${company.email}`}>{company.email}</a>
          </address>
          <div class="btns" style="margin-top:32px">
            <Btn href={`tel:${company.phoneHref}`} variant="red">Appeler</Btn>
            <Btn href={mapsLink(company.mapsQuery)} external>Itinéraire</Btn>
            <Btn href="/contact/">Écrire</Btn>
          </div>
        </div>
        <div class="h-contact__hours"><Hours /></div>
      </div>
    </div>
    <div class="h-finish" id="arrivee">
      <span class="wp" data-wp="self" style="left:50%"></span>
      <Sector n="8" name="Arrivée" id="arrivee" ghost />
      <div class="checker h-finish__band" aria-hidden="true"></div>
      <div class="wrap h-finish__meta"><span class="mono">Arrivée</span><span class="mono">{certifications.map((c) => c.name).join(' · ')}</span></div>
    </div>
  </section>
</Base>

<style is:global>
  .wp { position: absolute; left: 0; width: 1px; height: 1px; pointer-events: none; }
  section { position: relative; }

  /* HERO — photo plein écran, feux de départ */
  .h-hero { min-height: max(640px, 100svh); display: flex; flex-direction: column; justify-content: flex-end; color: var(--white); overflow: hidden; background: var(--ink); }
  .h-hero__bg { position: absolute !important; inset: 0; background: var(--ink); }
  .h-hero__bg img { height: 100%; animation: heroZoom 9s var(--ease) both; }
  @keyframes heroZoom { from { transform: scale(1.12); } }
  .h-hero__shade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(23,25,27,.15) 0%, rgba(23,25,27,0) 30%, rgba(23,25,27,.55) 62%, rgba(23,25,27,.92) 100%); }
  .h-hero__inner { position: relative; z-index: 4; padding-top: calc(var(--header) + 24px); padding-bottom: clamp(36px, 5vw, 72px); }
  .h-hero__kicker { color: rgba(255,255,255,.85); margin: 0 0 14px; }
  .h-hero__kicker b { color: #ff5c6c; font-weight: 500; }
  .h-hero__title { margin: 0 0 clamp(24px, 3vw, 40px); font-size: min(clamp(3rem, 9.6vw, 10.4rem), 9.4cqi); text-shadow: 0 2px 30px rgba(0,0,0,.25); }
  .h-hero__title .line { display: block; white-space: nowrap; }
  .h-hero__title .line:last-child { padding-left: 0.5em; }
  .h-hero .btn:not(.btn--red) { --fg: var(--white); --bd: rgba(255,255,255,.75); background: rgba(23,25,27,.25); }
  .h-hero .btn:not(.btn--red):hover { --bg: var(--white); --fg: var(--ink); background: var(--white); }
  .h-hero__grid { position: relative; z-index: 4; height: 32px; background-size: 16px 16px; }

  .h-start { position: relative; display: flex; align-items: center; gap: 18px; margin: 0 0 clamp(20px, 3vw, 40px) calc(var(--m) * -0.54); }
  @media (max-width: 900px) { .h-start { margin-left: -11px; } }
  .h-start .wp { top: 50%; left: 0; }
  .h-start__grid { width: calc(var(--m) * 0.54 + 56px); height: 24px; flex: none; background-size: 12px 12px; }
  .lights { display: flex; gap: 8px; padding: 8px 10px; background: #0d0e0f; border-radius: 4px; box-shadow: 0 0 0 1px rgba(255,255,255,.12); }
  .lights i { width: 18px; height: 18px; border-radius: 50%; background: #3a1216; box-shadow: inset 0 -2px 3px rgba(0,0,0,.6); animation: light .25s steps(1) both; }
  .lights i:nth-child(1) { animation-delay: .5s; } .lights i:nth-child(2) { animation-delay: .9s; } .lights i:nth-child(3) { animation-delay: 1.3s; }
  .lights i:nth-child(4) { animation-delay: 1.7s; } .lights i:nth-child(5) { animation-delay: 2.1s; }
  @keyframes light { from { background: #3a1216; } to { background: var(--red); box-shadow: 0 0 14px 2px rgba(226,0,26,.75), inset 0 -2px 3px rgba(0,0,0,.25); } }
  @media (prefers-reduced-motion: reduce) { .lights i { animation: none; background: var(--red); } .h-hero__bg img { animation: none; } }

  @media (max-width: 900px) {
    .h-hero { min-height: max(560px, 92svh); }
    .h-hero__title { font-size: min(clamp(2rem, 10.5vw, 5rem), 11cqi); }
    .h-hero__title .line { white-space: normal; }
    .h-hero__title .line:last-child { padding-left: 0; }
    .lights i { width: 13px; height: 13px; }
  }

  /* Bandeau défilant */
  .ticker { position: relative; z-index: 5; background: var(--red); color: var(--white); overflow: hidden; padding: 14px 0; border-bottom: 6px solid transparent; border-image: var(--kerb) 6; }
  .ticker__track { display: flex; width: max-content; animation: tick 38s linear infinite; }
  .ticker__track > span { display: flex; }
  .ticker__track span span { display: inline-flex; align-items: center; gap: 28px; padding-right: 28px; font-weight: 800; font-stretch: 125%; font-style: italic; text-transform: uppercase; font-size: clamp(1rem, 1.6vw, 1.45rem); letter-spacing: -0.01em; white-space: nowrap; }
  .ticker__track i { width: 22px; height: 12px; background: var(--checker); background-size: 6px 6px; flex: none; transform: skewX(-14deg); }
  .ticker--brands { background: var(--ink); border: 0; border-block: 1px solid rgba(255,255,255,.16); padding: 22px 0; }
  .ticker--brands .ticker__track { animation-duration: 46s; animation-direction: reverse; }
  .ticker--brands .ticker__track span span { font-size: clamp(1.4rem, 3vw, 2.8rem); color: transparent; -webkit-text-stroke: 1.2px rgba(255,255,255,.7); }
  .ticker--brands .ticker__track i { background: var(--red); width: 10px; height: 10px; transform: rotate(45deg); }
  @keyframes tick { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .ticker__track { animation: none; } }

  /* Titre + bouton sur une ligne */
  .h-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 40px; margin-bottom: clamp(36px, 5vw, 72px); }
  .h-head .display { flex: 1 1 520px; min-width: 0; }

  /* ENTREPRISE */
  .h-story__grid { align-items: end; row-gap: 40px; }
  .h-story__media { grid-column: 1 / span 7; }
  .h-story__text { grid-column: 8 / span 5; padding-bottom: 8px; }
  .h-year { font-size: min(clamp(5rem, 13vw, 13rem), 30cqi) !important; }
  .h-year { font-size: clamp(5rem, 13vw, 13rem); color: transparent; -webkit-text-stroke: 2px var(--red); margin: 0 0 .06em; line-height: .8; }
  .h-drivers { list-style: none; padding: 0; margin: 28px 0 32px; display: grid; gap: 12px; }
  .h-drivers li { display: flex; align-items: center; gap: 16px; }
  .h-drivers strong { font-size: clamp(1.3rem, 2vw, 1.9rem); font-stretch: 120%; font-style: italic; font-weight: 800; text-transform: uppercase; letter-spacing: -0.01em; line-height: 1; }
  .h-drivers strong span { color: var(--steel); }
  .plate { flex: none; display: grid; place-items: center; width: 54px; height: 54px; border-radius: 50%; background: var(--white); border: 3px solid var(--ink); font-weight: 900; font-stretch: 125%; font-style: italic; font-size: 1.6rem; line-height: 1; }
  .h-drivers li:first-child .plate { border-color: var(--red); color: var(--red); }
  .h-strip3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--g); margin-top: clamp(48px, 6vw, 96px); }
  .h-strip3 .pic:nth-child(2) { transform: translateY(clamp(0px, 4vw, 64px)); }
  @media (max-width: 900px) {
    .h-strip3 { grid-template-columns: 1fr 1fr; }
    .h-strip3 .pic:nth-child(2) { transform: none; }
    .h-strip3 .pic:nth-child(3) { grid-column: 1 / -1; aspect-ratio: 16/9 !important; }
  }

  /* CARROSSERIE — tuiles photo, numéros de course */
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: clamp(150px, 15vw, 250px); gap: var(--g); }
  .tile { position: relative; overflow: hidden; background: var(--ink); }
  .tile > a { position: absolute; inset: 0; display: block; color: var(--white); text-decoration: none; }
  .tile .pic { position: absolute; inset: 0; }
  .tile .pic img { height: 100%; transition: transform .9s var(--ease), clip-path 1.25s var(--ease-io); }
  .tile > a::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(23,25,27,0) 40%, rgba(23,25,27,.85) 100%); pointer-events: none; }
  .tile > a::before { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 8px; background: var(--kerb); z-index: 2; transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease); }
  .tile > a:hover::before, .tile > a:focus-visible::before { transform: scaleX(1); }
  .js .tile [data-mask].is-in img, .tile .pic img { transform: scale(1); }
  .tile > a:hover .pic img { transform: scale(1.06); }
  .tile__no { position: absolute; z-index: 2; top: 14px; left: 14px; display: grid; place-items: center; min-width: 64px; height: 52px; padding: 0 10px; background: var(--white); color: var(--ink); font-weight: 900; font-stretch: 125%; font-style: italic; font-size: 2rem; line-height: 1; letter-spacing: -0.03em; border-left: 6px solid var(--red); }
  .tile__title { position: absolute; z-index: 2; left: 18px; right: 18px; bottom: 20px; font-weight: 800; font-stretch: 122%; font-style: italic; text-transform: uppercase; letter-spacing: -0.015em; line-height: 1; font-size: clamp(1.15rem, 1.8vw, 1.7rem); }
  .tile--1 { grid-column: 1 / span 7; grid-row: span 2; }
  .tile--1 .tile__no { min-width: 96px; height: 76px; font-size: 3rem; }
  .tile--1 .tile__title { font-size: clamp(1.6rem, 3vw, 2.8rem); }
  .tile--2 { grid-column: 8 / span 5; }
  .tile--3 { grid-column: 8 / span 5; }
  .tile--4 { grid-column: 1 / span 4; }
  .tile--5 { grid-column: 5 / span 4; }
  .tile--6 { grid-column: 9 / span 4; }
  .tile--7 { grid-column: 1 / span 8; }
  .tile--cta { grid-column: 9 / span 4; background: var(--red); color: var(--white); padding: clamp(18px, 2vw, 28px); display: flex; align-items: flex-end; }
  .tile--cta ul { list-style: none; padding: 0; margin: 6px 0 20px; font-weight: 800; font-stretch: 118%; font-style: italic; text-transform: uppercase; line-height: 1.15; font-size: clamp(1rem, 1.4vw, 1.25rem); }
  .tile--cta .mono { margin: 0; opacity: .8; }
  .tile--cta .btn--solid:hover { --bg: var(--white); --fg: var(--ink); --bd: var(--white); }
  @media (max-width: 900px) {
    .tiles { grid-template-columns: 1fr; grid-auto-rows: 190px; gap: 10px; }
    .tiles > li { grid-column: span 1 !important; grid-row: span 1 !important; }
