---
import Base from '../layouts/Base.astro';
import Pic from '../components/Pic.astro';
import Btn from '../components/Btn.astro';
import Sector from '../components/Sector.astro';
import Todo from '../components/Todo.astro';
import Placeholder from '../components/Placeholder.astro';
import Hours from '../components/Hours.astro';
import ContactForm from '../components/ContactForm.astro';
import { company, services, storage, wash, prestigeBrands, mapsLink, certifications } from '../data/site';
---
<Base
  title="Winiger Frères · Carrosserie de Grolley (Fribourg) — depuis 2004"
  description="Carrosserie toutes marques à Grolley (FR) depuis 2004 : réparation, peinture, vitrages, véhicules de prestige et de collection, TESLA Approved Body Shop, gardiennage chauffé et tunnel de lavage."
  schema
>
  <!-- ========== S1 · DÉPART ========== -->
  <section class="h-hero" id="depart" aria-labelledby="h-hero-title">
    <Sector n="1" name="Départ" id="ligne-depart" href="#depart" ghost />
    <div class="wrap">
      <div class="h-start" id="ligne-depart" aria-hidden="true">
        <span class="wp" data-wp="l"></span>
        <div class="h-start__grid checker"></div>
        <span class="mono">Départ</span>
      </div>
      <p class="eyebrow" data-reveal>Carrosserie de Grolley <b>·</b> depuis {company.founded}</p>
      <h1 id="h-hero-title" class="display giant h-hero__title">
        <span class="line" data-reveal>La précision</span>
        <span class="line" data-reveal data-delay="1">pour passion<span class="red">.</span></span>
      </h1>
    </div>
    <div class="wrap grid h-hero__grid">
      <div class="h-hero__text">
        <p class="lead" data-reveal data-delay="2">Depuis 2004, Winiger Frères met son savoir-faire au service de l'automobile à Grolley.</p>
        <div class="btns" data-reveal data-delay="3">
          <Btn href="/carrosserie/" variant="solid">Découvrir nos prestations</Btn>
          <Btn href="/contact/">Contacter l'atelier</Btn>
        </div>
      </div>
      <div class="h-hero__media">
        <Pic name="ext-008" ratio="3/2" class="corner-tl" sizes="(min-width: 901px) 58vw, 100vw" priority position="50% 60%" />
        <p class="cap">Route de l'Industrie-Ouest 11 — 1772 Grolley</p>
      </div>
    </div>
    <div class="wrap">
      <dl class="h-strip" data-reveal>
        <div><dt>Fondation</dt><dd>2004</dd></div>
        <div><dt>Atelier</dt><dd>Grolley · Fribourg</dd></div>
        <div><dt>Agrément</dt><dd>TESLA Approved Body Shop</dd></div>
        <div><dt>Prestations</dt><dd>Carrosserie · Prestige · Gardiennage · Lavage</dd></div>
      </dl>
    </div>
  </section>

  <!-- ========== S2 · L'ENTREPRISE ========== -->
  <section class="section h-story" id="entreprise" aria-labelledby="h-story-title">
    <span class="wp" data-wp="l" style="top:40px"></span>
    <Sector n="2" name="L'entreprise" id="entreprise" />
    <div class="wrap">
      <p class="h-year display outline-text" aria-hidden="true" data-reveal>2004</p>
      <div class="grid h-story__grid">
        <div class="h-story__media">
          <Pic name="enseigne-6221" ratio="5/4" sizes="(min-width: 901px) 45vw, 100vw" position="50% 50%" />
          <div class="h-story__media2 hide-m"><Pic name="ext-025" ratio="3/2" sizes="22vw" mask="corner" /></div>
        </div>
        <div class="h-story__text">
          <p class="eyebrow">S2 <b>/</b> Notre histoire</p>
          <h2 id="h-story-title" class="display h2">Deux frères,<br />une passion.</h2>
          <div class="prose" style="margin-top:32px">
            <p class="lead">L'entreprise est née en 2004 de la passion de deux frères pour l'automobile.</p>
            <p>Cette passion les a conduits à se spécialiser dans la réparation toutes marques, la restauration et la compétition. Aujourd'hui, la Carrosserie de Grolley réunit l'atelier, un espace de gardiennage et une station de lavage dans la zone industrielle de Grolley.</p>
          </div>
          <ul class="h-drivers" aria-label="Les frères Winiger">
            {company.founders.map((f, i) => (
              <li><span class="mono">0{i + 1}</span><strong>{f.first} <span>{f.last}</span></strong></li>
            ))}
          </ul>
          <p style="margin:18px 0 32px"><Todo text="Portraits & parcours des frères à fournir" /></p>
          <Btn href="/entreprise/">Notre entreprise</Btn>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== S3 · CARROSSERIE ========== -->
  <section class="section bg-paper h-services" id="carrosserie" aria-labelledby="h-serv-title">
    <span class="wp" data-wp="r" style="top:40px"></span>
    <Sector n="3" name="Carrosserie" id="carrosserie" />
    <div class="wrap">
      <div class="grid h-services__head">
        <div style="grid-column: 1 / span 7">
          <p class="eyebrow">S3 <b>/</b> Carrosserie & savoir-faire</p>
          <h2 id="h-serv-title" class="display h2">Toutes marques.<br />Tous travaux.</h2>
        </div>
        <p class="lead" style="grid-column: 9 / span 4; align-self:end">Un personnel constamment formé aux exigences de toutes les marques, et un accompagnement dans l'annonce et la gestion des sinistres.</p>
      </div>
      <div class="grid h-index" data-index>
        <ol class="h-index__list">
          {services.map((s, i) => (
            <li data-row={s.id} class:list={[i === 0 && 'is-active']}>
              <a href={`/carrosserie/#${s.id}`}>
                <span class="mono h-index__code">{s.code}</span>
                <span class="h-index__title">{s.title}</span>
                <span class="h-index__text">{s.text}</span>
                <span class="arr" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ol>
        <div class="h-index__preview hide-m" aria-hidden="true">
          {services.map((s, i) => (
            <div class="h-index__frame" data-preview={s.id} class:list={[i === 0 && 'is-active']}>
              {s.img ? <Pic name={s.img as any} ratio="4/5" sizes="34vw" mask={false} alt="" /> : <Placeholder text={s.ph!} ratio="4/5" />}
              <span class="mono">{s.code} — {s.title}</span>
            </div>
          ))}
        </div>
      </div>
      <ul class="h-adv" aria-label="Vos avantages">
        <li>Facilité avec les assurances</li>
        <li>Voitures de remplacement récentes</li>
        <li>Qualité garantie FCR</li>
        <li>Devis gratuits</li>
      </ul>
    </div>
  </section>

  <!-- ========== S4 · PRESTIGE ========== -->
  <section class="section bg-ink h-prestige on-dark" id="prestige" aria-labelledby="h-pres-title">
    <span class="wp" data-wp="r" style="top:40px"></span>
    <Sector n="4" name="Prestige" id="prestige" side="r" />
    <div class="wrap">
      <div class="grid">
        <div style="grid-column: 1 / span 8">
          <p class="eyebrow">S4 <b>/</b> Prestige, collection & compétition</p>
          <h2 id="h-pres-title" class="display h1">Sport,<br />prestige<br /><span class="outline-text">& collection</span></h2>
        </div>
      </div>
      <div class="h-prestige__hero">
        <Pic name="ferrari-6215" ratio="21/9" sizes="(min-width: 1520px) 1340px, 100vw" class="corner-br" />
      </div>
      <div class="grid h-prestige__body">
        <div class="prose" style="grid-column: 1 / span 5">
          <p class="lead">Spécialisés dans les véhicules de sport, de prestige et de collection, nous avons obtenu la reconnaissance de nombreux représentants de marques de prestige.</p>
        </div>
        <div style="grid-column: 7 / span 6">
          <p class="mono muted">Marques réparées régulièrement à l'atelier</p>
          <p class="h-brands">{prestigeBrands.map((b, i) => <span>{b}{i < prestigeBrands.length - 1 && <i aria-hidden="true">/</i>}</span>)}</p>
          <p class="mono muted" style="margin-top:14px">Liste publiée par l'entreprise — exemples de véhicules réparés, sans partenariat de marque.</p>
        </div>
      </div>
      <div class="grid h-prestige__duo">
        <a class="h-duo" href="/prestige-collection/#restauration" style="grid-column: 1 / span 5">
          <Pic name="resto-3463" ratio="4/3" sizes="(min-width: 901px) 40vw, 100vw" />
          <span class="h3">Restauration & peinture ancienne</span>
          <span class="link">Voir la restauration <span class="arr" aria-hidden="true"></span></span>
        </a>
        <a class="h-duo h-duo--low" href="/prestige-collection/#competition" style="grid-column: 7 / span 6">
          <Pic name="course-fb3" ratio="16/9" sizes="(min-width: 901px) 48vw, 100vw" />
          <span class="h3">Compétition</span>
          <span class="link">Voir la compétition <span class="arr" aria-hidden="true"></span></span>
        </a>
      </div>
      <div class="h-tesla" id="tesla-home">
        <div class="h-tesla__badge">
          <span class="mono">Agrément constructeur</span>
          <strong>TESLA<br />Approved<br />Body Shop</strong>
          <span class="mono red">Depuis mai 2021</span>
        </div>
        <div class="h-tesla__text">
          <p>Membre du réseau d'ateliers de carrosserie approuvés par TESLA. Une formation spécifique pour réparer des véhicules électriques en aluminium et acier, et les systèmes haute tension, dans le respect des standards de la marque.</p>
          <dl class="spec">
            <div><dt>Étalonnage</dt><dd>Calibrage du radar après toute intervention sur le capteur</dd></div>
            <div><dt>Tôlerie</dt><dd>Réparation sans chaleur ni vibration excessives près des capteurs à ultrasons</dd></div>
            <div><dt>Peinture</dt><dd>Épaisseur limitée à 300 microns dans la zone des capteurs</dd></div>
          </dl>
          <div class="btns" style="margin-top:28px"><Btn href="/prestige-collection/#tesla" variant="solid">La compétence Tesla</Btn></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== S5 · GARDIENNAGE ========== -->
  <section class="section h-storage" id="gardiennage" aria-labelledby="h-stor-title">
    <span class="wp" data-wp="l" style="top:40px"></span>
    <Sector n="5" name="Gardiennage" id="gardiennage" />
    <div class="wrap">
      <div class="grid">
        <div class="h-storage__media">
          <div class="h-bays">
            <Pic name="gard-2" ratio="4/3" sizes="(min-width: 901px) 58vw, 100vw" />
            <div class="h-bays__lines" aria-hidden="true"><span>P.01</span><span>P.02</span><span>P.03</span></div>
          </div>
        </div>
        <div class="h-storage__text">
          <p class="eyebrow">S5 <b>/</b> Gardiennage automobile</p>
          <h2 id="h-stor-title" class="display h2">Au chaud.<br />À l'abri.<br /><span class="red">En sécurité.</span></h2>
          <p class="lead" style="margin:28px 0 32px">Pour les véhicules de collection, de prestige, de sport ou de compétition : {storage.intro.charAt(0).toLowerCase() + storage.intro.slice(1)}</p>
          <dl class="spec">
            <div><dt>Durée</dt><dd>{storage.duration}</dd></div>
            <div><dt>Restitution</dt><dd>{storage.returnState}</dd></div>
            <div><dt>Tarif</dt><dd>Dès CHF 200.– par mois · Hivernage 6 mois CHF 1'000.–</dd></div>
          </dl>
          <div class="btns" style="margin-top:32px"><Btn href="/gardiennage/" variant="solid">Découvrir le gardiennage</Btn></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== S6 · STATION DE LAVAGE ========== -->
  <section class="section bg-paper h-wash" id="lavage" aria-labelledby="h-wash-title">
    <span class="wp" data-wp="r" style="top:40px"></span>
    <Sector n="6" name="Station de lavage" id="lavage" />
    <div class="h-lane" aria-hidden="true"><span>Voie de lavage</span><span>→</span><span>Voie de lavage</span><span>→</span><span>Voie de lavage</span></div>
    <div class="wrap">
      <div class="grid">
        <div class="h-wash__text">
          <p class="eyebrow">S6 <b>/</b> Station de lavage</p>
          <h2 id="h-wash-title" class="display h2">Le soin<br />jusqu'au dernier<br />détail<span class="red">.</span></h2>
          <p class="lead" style="margin-top:28px">{wash.type}, sur la même route que la carrosserie. {wash.promise}</p>
          <div class="btns" style="margin-top:32px">
            <Btn href="/station-de-lavage/" variant="solid">Découvrir la station</Btn>
            <Btn href={mapsLink(wash.mapsQuery)} external>Nous trouver</Btn>
          </div>
        </div>
        <div class="h-wash__panel">
          <Placeholder text="Le tunnel de lavage — vue de l'entrée, véhicule en cours de lavage." ratio="16/10" />
          <dl class="spec" style="margin-top:28px">
            <div><dt>Installation</dt><dd>{wash.type}</dd></div>
            <div><dt>Adresse</dt><dd>{wash.street}, 1772 Grolley</dd></div>
            <div><dt>Tarif</dt><dd>{wash.priceFrom} <Todo text="à confirmer" /></dd></div>
            <div><dt>Horaires</dt><dd><Todo /></dd></div>
            <div><dt>Paiement</dt><dd><Todo /></dd></div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== LOCAUX ========== -->
  <section class="section h-place" id="locaux" aria-labelledby="h-place-title">
    <span class="wp" data-wp="l" style="top:40px"></span>
    <div class="wrap">
      <div class="grid" style="align-items:end">
        <div style="grid-column: 1 / span 8">
          <p class="eyebrow">Nos locaux & notre univers</p>
          <h2 id="h-place-title" class="display h2">Industrie-Ouest<br />11<span class="red">.</span></h2>
        </div>
        <div style="grid-column: 9 / span 4; display:flex; justify-content:flex-end" class="hide-m"><Btn href="/locaux/">Toutes les photos</Btn></div>
      </div>
      <div class="h-mosaic">
        <Pic name="facade-nuit-a" class="m1" sizes="(min-width: 901px) 66vw, 85vw" />
        <Pic name="reception-9997" class="m2" sizes="(min-width: 901px) 30vw, 85vw" />
        <Pic name="atelier-6223" class="m3" sizes="(min-width: 901px) 22vw, 85vw" />
        <Pic name="atelier-fb2" class="m4" sizes="(min-width: 901px) 44vw, 85vw" />
        <Pic name="gard-3" class="m5" sizes="(min-width: 901px) 30vw, 85vw" />
      </div>
      <div class="only-m" style="margin-top:24px"><Btn href="/locaux/">Toutes les photos</Btn></div>
    </div>
  </section>

  <!-- ========== S7 · CONTACT / S8 · ARRIVÉE ========== -->
  <section class="section bg-ink h-contact on-dark" id="contact" aria-labelledby="h-contact-title">
    <span class="wp" data-wp="r" style="top:40px"></span>
    <Sector n="7" name="Contact" id="contact" side="r" />
    <div class="wrap">
      <p class="eyebrow">S7 <b>/</b> Contact</p>
      <h2 id="h-contact-title" class="display giant">Ligne<br />d'arrivée<span class="red">.</span></h2>
      <div class="grid h-contact__grid">
        <div class="h-contact__info">
          <address>
            <strong>{company.name}</strong><br />
            {company.tagline}<br />
            {company.street}<br />
            {company.zip} {company.city}
          </address>
          <p class="h-contact__phone"><a href={`tel:${company.phoneHref}`}>{company.phone}</a></p>
          <p><a class="link" href={`mailto:${company.email}`}>{company.email}</a></p>
          <div class="btns" style="margin:28px 0 40px">
            <Btn href={`tel:${company.phoneHref}`} variant="red">Appeler l'atelier</Btn>
            <Btn href={mapsLink(company.mapsQuery)} external>Itinéraire</Btn>
          </div>
          <Hours />
        </div>
        <div class="h-contact__form">
          <h3 class="h3" style="margin-bottom:28px">Écrire à l'atelier</h3>
          <div class="light-form"><ContactForm compact idPrefix="home" /></div>
        </div>
      </div>
    </div>
    <div class="h-finish" id="arrivee">
      <span class="wp" data-wp="self" style="left:50%"></span>
      <Sector n="8" name="Arrivée" id="arrivee" ghost />
      <div class="checker h-finish__band" aria-hidden="true"></div>
      <div class="wrap h-finish__meta"><span class="mono">Arrivée</span><span class="mono">{certifications.map((c) => c.name).join(' · ')}</span></div>
    </div>
  </section>
</Base>

<style is:global>
  .wp { position: absolute; left: 0; width: 1px; height: 1px; pointer-events: none; }
  section { position: relative; }

  /* HERO */
  .h-hero { padding-top: calc(var(--header) + clamp(20px, 3.4vw, 56px)); padding-bottom: clamp(40px, 5vw, 72px); }
  .h-hero__grid { align-items: end; row-gap: 40px; margin-top: clamp(28px, 3vw, 48px); }
  .h-hero__title { margin: 0; font-size: min(clamp(2.6rem, 8.3vw, 9.4rem), 8.6cqi); }
  .h-hero__title .line { display: block; white-space: nowrap; }
  .h-hero__title .line:last-child { padding-left: 0.62em; }
  .h-hero__text { grid-column: 1 / span 5; position: relative; z-index: 2; align-self: start; padding-top: clamp(8px, 2vw, 32px); }
  .h-hero .lead { margin-bottom: 32px; }
  .h-hero__media { grid-column: 6 / span 7; position: relative; }
  .h-start { position: relative; margin-bottom: clamp(20px, 2.4vw, 32px); margin-left: calc(var(--m) * -0.54); display: flex; align-items: center; gap: 16px; }
  @media (max-width: 900px) { .h-start { margin-left: -11px; } }
  .h-start .wp { top: 50%; left: 0; }
  .h-start__grid { width: calc(var(--m) * 0.54 + 48px); height: 16px; flex: none; background-size: 8px 8px; }
  .h-start .mono { color: var(--steel); }
  .h-strip { margin: clamp(40px, 5vw, 72px) 0 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1.5px solid var(--ink); }
  .h-strip div { padding: 16px 16px 0 0; border-right: 1px solid var(--line); margin-right: 16px; }
  .h-strip div:last-child { border-right: 0; }
  .h-strip dt { font-family: var(--f-mono); font-size: var(--fs-mono); letter-spacing: .14em; text-transform: uppercase; color: var(--steel); margin-bottom: 6px; }
  .h-strip dd { margin: 0; font-weight: 650; font-stretch: 112%; }
  @media (max-width: 900px) {
    .h-hero__title { font-size: min(clamp(2.3rem, 11.4vw, 5rem), 14cqi); }
    .h-hero__title .line { white-space: normal; }
    .h-hero__title .line:last-child { padding-left: 0; }
    .h-strip { grid-template-columns: 1fr 1fr; row-gap: 18px; }
    .h-strip div:nth-child(2) { border-right: 0; }
  }

  /* HISTOIRE */
  .h-year { font-size: clamp(6rem, 27vw, 26rem); margin: 0 0 clamp(-80px, -6vw, -30px); line-height: .8; letter-spacing: -0.05em; text-align: right; }
  .h-story__grid { row-gap: 48px; align-items: start; }
  .h-story__media { grid-column: 1 / span 6; position: relative; }
  .h-story__media2 { position: absolute; width: 46%; right: -14%; bottom: -18%; border: 10px solid var(--white); }
  .h-story__text { grid-column: 8 / span 5; padding-top: clamp(0px, 8vw, 140px); }
  .h-drivers { list-style: none; padding: 0; margin: 36px 0 0; border-top: 1.5px solid var(--ink); }
  .h-drivers li { display: flex; align-items: baseline; gap: 20px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .h-drivers strong { font-size: clamp(1.4rem, 2.2vw, 2rem); font-stretch: 120%; font-weight: 750; text-transform: uppercase; letter-spacing: -0.01em; }
  .h-drivers strong span { color: var(--steel); }

  @media (max-width: 900px) { .h-year { margin-bottom: 12px; text-align: left; } .h-story__text { padding-top: 0; } }

  /* CARROSSERIE — index technique */
  .h-services__head { margin-bottom: clamp(40px, 6vw, 88px); row-gap: 24px; }
  .h-index { align-items: start; }
  .h-index__list { grid-column: 1 / span 7; list-style: none; margin: 0; padding: 0; border-top: 1.5px solid var(--ink); counter-reset: s; }
  .h-index__list li { border-bottom: 1px solid var(--line-strong); }
  .h-index__list a { display: grid; grid-template-columns: 64px minmax(0, 1fr) 28px; column-gap: 16px; align-items: center; padding: 22px 0; text-decoration: none; position: relative; }
  .h-index__list a::before { content: ''; position: absolute; left: 0; bottom: -1px; height: 3px; width: 100%; background: var(--kerb); transform: scaleX(0); transform-origin: left; transition: transform .5s var(--ease); }
  .h-index__code { color: var(--steel); transition: color .3s; }
  .h-index__title { font-size: clamp(1.35rem, 2.5vw, 2.35rem); font-weight: 760; font-stretch: 118%; text-transform: uppercase; letter-spacing: -0.02em; line-height: 1.05; transition: transform .45s var(--ease); }
  .h-index__text { grid-column: 2 / 3; font-size: .95rem; color: var(--ink-2); max-width: 52ch; max-height: 0; overflow: hidden; opacity: 0; transition: max-height .5s var(--ease), opacity .4s, margin .4s; }
  .h-index__list .arr { grid-row: 1; grid-column: 3; width: 22px; height: 12px; position: relative; justify-self: end; }
  .h-index__list .arr::before { content: ''; position: absolute; left: 0; right: 2px; top: 50%; height: 1.5px; background: currentColor; }
  .h-index__list .arr::after { content: ''; position: absolute; right: 1px; top: 50%; width: 8px; height: 8px; border-top: 1.5px solid currentColor; border-right: 1.5px solid currentColor; transform: translateY(-50%) rotate(45deg); margin-top: .5px; }
  .h-index__list li.is-active a::before, .h-index__list a:focus-visible::before { transform: scaleX(1); }
  .h-index__list li.is-active .h-index__code { color: var(--red); }
  .h-index__list li.is-active .h-index__title { transform: translateX(8px); }
  .h-index__list li.is-active .h-index__text { max-height: 120px; opacity: 1; margin-top: 10px; }
  .h-index__preview { grid-column: 9 / span 4; position: sticky; top: calc(var(--header) + 32px); }
  .h-index__frame { display: none; }
  .h-index__frame.is-active { display: block; animation: frameIn .6s var(--ease); }
  .h-index__frame .mono { display: block; margin-top: 12px; color: var(--steel); }
  .h-index__frame .pic { border-top-right-radius: clamp(40px, 6vw, 100px); }
  @keyframes frameIn { from { clip-path: polygon(0 0, 0 0, -12% 100%, 0 100%); } to { clip-path: polygon(0 0, 112% 0, 100% 100%, 0 100%); } }
