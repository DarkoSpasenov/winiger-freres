---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Pic from '../../components/Pic.astro';
import Btn from '../../components/Btn.astro';
import Sector from '../../components/Sector.astro';
import Todo from '../../components/Todo.astro';
import { images, type ImageName } from '../../data/images';

type G = { id: string; n: string; title: string; intro: string; items: { name: ImageName; shape: string }[] };
const groups: G[] = [
  { id: 'batiment', n: '1', title: 'Le bâtiment', intro: "Route de l'Industrie-Ouest 11, zone industrielle de Grolley.",
    items: [ { name: 'facade-nuit-a', shape: 'xl' }, { name: 'ext-013', shape: 'm' }, { name: 'ext-009', shape: 'tall' }, { name: 'ext-020', shape: 'm' }, { name: 'facade-enseigne', shape: 'wide' }, { name: 'ext-008', shape: 's' }, { name: 'ext-027', shape: 's' }, { name: 'ext-6185', shape: 'm' }, { name: 'atelier-6288', shape: 'tall' }, { name: 'ext-5161', shape: 'm' }, { name: 'tunnel-sortie', shape: 'wide' } ] },
  { id: 'accueil', n: '2', title: "L'accueil", intro: 'Réception et espace clients.',
    items: [ { name: 'reception-2023', shape: 'xl' }, { name: 'reception-9997', shape: 'wide' }, { name: 'ext-016', shape: 'm' }, { name: 'enseigne-6221', shape: 'm' } ] },
  { id: 'atelier', n: '3', title: "L'atelier", intro: 'Carrosserie, préparation et peinture.',
    items: [ { name: 'atelier-fb2', shape: 'xl' }, { name: 'atelier-cabines', shape: 'wide' }, { name: 'atelier-sportives', shape: 'm' }, { name: 'atelier-6223', shape: 'tall' }, { name: 'atelier-6314', shape: 'm' }, { name: 'peinture-6309', shape: 'm' }, { name: 'atelier-6191', shape: 'wide' }, { name: 'atelier-6194', shape: 'm' }, { name: 'atelier-9880', shape: 's' }, { name: 'atelier-fb1', shape: 'm' } ] },
  { id: 'gardiennage', n: '4', title: 'Le gardiennage', intro: 'Le sous-sol chauffé réservé aux véhicules.',
    items: [ { name: 'gard-sportives', shape: 'xl' }, { name: 'gard-2', shape: 'wide' }, { name: 'gard-1', shape: 'm' }, { name: 'gard-3', shape: 'm' }, { name: 'gard-6295', shape: 'm' } ] },
  { id: 'realisations', n: '5', title: 'Réalisations', intro: 'Travaux en cours à l’atelier : prestige, restauration et compétition.',
    items: [ { name: 'ferrari-6215', shape: 'xl' }, { name: 'course-gt4', shape: 'tall' }, { name: 'proto-competition', shape: 'm' }, { name: 'resto-alpine-tolerie', shape: 'wide' }, { name: 'resto-911-caisse', shape: 'm' }, { name: 'resto-alpine-appret', shape: 'm' }, { name: 'huracan-reparation', shape: 'm' }, { name: 'huracan-appret', shape: 'm' }, { name: 'peinture-pare-chocs', shape: 'm' }, { name: 'gt3-enseigne', shape: 'wide' }, { name: 'gt3-noire', shape: 'm' }, { name: 'course-911-cup', shape: 'm' }, { name: 'resto-3463', shape: 'm' }, { name: 'course-fb3', shape: 'wide' }, { name: 'course-9851', shape: 'm' }, { name: 'atelier-9877', shape: 'm' }, { name: 'atelier-fb7', shape: 'tall' }, { name: 'atelier-fb4', shape: 'm' }, { name: 'atelier-fb5', shape: 'm' }, { name: 'atelier-fb6', shape: 'wide' }, { name: 'atelier-4916', shape: 's' }, { name: 'atelier-6191', shape: 'm' }, { name: 'atelier-2441', shape: 'm' } ] },
];
const big = (n: ImageName) => `/images/${n}-${Math.min(1920, images[n].w)}.webp`;
---
<Base title="Nos locaux & réalisations — l'atelier en images" description="Le bâtiment, l'atelier, l'espace de gardiennage et les réalisations de Winiger Frères à Grolley, en photographies.">
  <PageHero img="ext-020" id="galerie" labelledby="l-title" position="50% 55%">
    <Fragment slot="marks">
      <span class="wp" data-wp="l" style="top:calc(var(--header) + 20px)"></span>
    </Fragment>
    <p class="eyebrow">Nos locaux & réalisations</p>
    <h1 id="l-title" class="display">L'atelier<br />en images<span class="red">.</span></h1>
  </PageHero>
  <div class="wrap l-tocwrap">
    <nav class="l-toc" aria-label="Rubriques de la galerie">
      {groups.map((g) => <a href={`#${g.id}`}><span class="mono">0{g.n}</span>{g.title}</a>)}
    </nav>
  </div>

  {groups.map((g, gi) => (
    <section class:list={['section section--tight l-group', gi % 2 === 1 && 'bg-paper']} id={g.id} aria-labelledby={`lt-${g.id}`}>
      <span class="wp" data-wp={gi % 2 ? 'r' : 'l'} style="top:30px"></span>
      <Sector n={g.n} name={g.title} id={g.id} side={gi % 2 ? 'r' : 'l'} />
      <div class="wrap">
        <div class="l-head">
          <h2 id={`lt-${g.id}`} class="display h2">{g.title}</h2>
          <p class="mono muted">{g.intro} · {String(g.items.length).padStart(2, '0')} photos</p>
        </div>
        <div class="l-grid">
          {g.items.map((it) => (
            <a class={`l-item l-${it.shape}`} href={big(it.name)} data-lightbox>
              <Pic name={it.name} sizes="(min-width: 901px) 40vw, 90vw" />
              <span class="sr-only">Agrandir la photo</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section section--tight" aria-label="Photos à venir">
    <span class="wp" data-wp="l" style="top:30px"></span>
    <div class="wrap l-end">
      <p class="lead">Photographies récentes des réalisations, de l'équipe et de la station de lavage <Todo text="à fournir" /></p>
      <div class="btns"><Btn href="https://www.instagram.com/carrosserie_winiger_freres_/" external>Instagram</Btn><Btn href="https://www.facebook.com/carrosseriewinigersarl/" external>Facebook</Btn></div>
    </div>
  </section>

  <dialog id="lightbox" class="lb" aria-label="Visionneuse de photos">
    <div class="lb-bar"><span class="mono lb-count"></span><button class="lb-close" type="button" aria-label="Fermer la visionneuse">Fermer ✕</button></div>
    <img alt="" />
    <div class="lb-bar"><button class="lb-prev" type="button" aria-label="Photo précédente">← Préc.</button><span class="lb-cap mono"></span><button class="lb-next" type="button" aria-label="Photo suivante">Suiv. →</button></div>
  </dialog>
</Base>
<style is:global>
  .wp { position: absolute; left: 0; width: 1px; height: 1px; pointer-events: none; }
  .l-hero { padding-bottom: clamp(24px, 4vw, 56px); }
  .l-tocwrap { padding-top: clamp(40px, 5vw, 72px); }
  .l-toc { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); column-gap: var(--g); border-top: 1.5px solid var(--ink); }
  .l-toc a { display: flex; gap: 14px; padding: 10px 0; border-bottom: 1px solid var(--line); text-decoration: none; font-weight: 600; font-stretch: 110%; }
  .l-toc a .mono { color: var(--red); }
  .l-toc a:hover { color: var(--red); }
  .l-head { display: flex; justify-content: space-between; align-items: baseline; gap: 16px 32px; flex-wrap: wrap; margin-bottom: clamp(24px, 3vw, 44px); }
  .l-grid { display: grid; grid-template-columns: repeat(12, 1fr); grid-auto-rows: clamp(64px, 6.5vw, 110px); grid-auto-flow: dense; gap: var(--g); }
  .l-item { display: block; position: relative; overflow: hidden; }
  .l-item .pic { height: 100%; }
  .l-item img { transition: transform .9s var(--ease); }
  .l-item:hover img { transform: scale(1.035); }
  .l-item::after { content: '+'; position: absolute; right: 10px; bottom: 10px; width: 34px; height: 34px; display: grid; place-items: center; background: var(--white); color: var(--ink); font-family: var(--f-mono); opacity: 0; transition: opacity .3s; }
  .l-item:hover::after, .l-item:focus-visible::after { opacity: 1; }
  .l-xl { grid-column: span 8; grid-row: span 5; }
  .l-wide { grid-column: span 6; grid-row: span 3; }
  .l-tall { grid-column: span 3; grid-row: span 5; }
  .l-m { grid-column: span 4; grid-row: span 3; }
  .l-s { grid-column: span 3; grid-row: span 2; }
  @media (max-width: 900px) {
    .l-grid { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 42vw; gap: 10px; }
    .l-xl, .l-wide { grid-column: span 2; grid-row: span 1; }
    .l-tall { grid-column: span 1; grid-row: span 2; }
    .l-m, .l-s { grid-column: span 1; grid-row: span 1; }
  }
  .l-end { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .lb { border: 0; padding: 0; max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; background: rgba(23,25,27,.97); color: var(--white); }
  .lb[open] { display: grid; grid-template-rows: auto 1fr auto; }
  .lb::backdrop { background: rgba(23,25,27,.9); }
  .lb img { width: 100%; height: 100%; object-fit: contain; min-height: 0; padding: 0 var(--m); }
  .lb-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px var(--m); }
  .lb-cap { color: var(--steel-2); text-align: center; flex: 1; }
  .lb button { background: none; border: 1px solid rgba(255,255,255,.4); color: var(--white); padding: 10px 14px; min-height: 44px; font-family: var(--f-mono); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; cursor: pointer; }
  .lb button:hover { border-color: var(--red); background: var(--red); }
</style>
